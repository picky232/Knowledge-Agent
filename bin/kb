#!/bin/bash
set -euo pipefail

DIR="/Users/jiho0215/knowledge-agent"
source "$DIR/.venv/bin/activate"
cd "$DIR/src"

case "${1:-}" in
  ask)
    shift
    python3 app/ask.py "$@"
    ;;
  ask-resume)
    shift
    python3 app/ask_resumable.py "$@"
    ;;
  sync)
    python3 app/sync.py
    ;;
  log)
    shift
    python3 app/log_search.py "$@"
    ;;
  bench)
    shift
    python3 app/run_benchmark.py "$@"
    ;;
  index)
    "$EDITOR" "$DIR/data/index/INDEX.md" 2>/dev/null || open "$DIR/data/index/INDEX.md"
    ;;
  web)
    echo "http://127.0.0.1:8420 (Ctrl-C로 종료)"
    open "http://127.0.0.1:8420" 2>/dev/null &
    python3 app/webserver.py
    ;;
  gui)
    python3 app/gui.py
    ;;
  watch-focus)
    python3 app/watch_focus.py
    ;;
  watch-window)
    python3 app/watch_window.py
    ;;
  watch-files)
    python3 app/watch_files.py
    ;;
  watch-screen)
    python3 app/watch_screen.py
    ;;
  *)
    cat <<'USAGE'
사용법:
  kb ask "질문"            질문하고 바로 답 받기
  kb ask-resume "질문"      중단돼도 이어쓰기 되는 질의
  kb sync                  전체 소스 재인덱싱
  kb log "검색어" "url" "메모"   웹서칭 기록 남기기
  kb bench [개수]           자동 벤치마크 테스트
  kb index                 주제 요약 인덱스(INDEX.md) 열기
  kb web                   브라우저에서 채팅 화면 열기(로컬 서버)
  kb gui                   네이티브 창으로 채팅 화면 열기
  kb watch-focus           앱 전환 감시 데몬 실행(foreground, Ctrl-C로 종료)
  kb watch-window          창 제목 감시 데몬 실행(손쉬운 사용 권한 필요, foreground)
  kb watch-files           파일 작업 감시 데몬 실행(foreground, Ctrl-C로 종료)
  kb watch-screen          화면 텍스트 감시 데몬 실행(화면 기록 권한 필요, foreground)
USAGE
    ;;
esac
